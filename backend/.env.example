# === STACK GRATUITO (por defecto) ===
AI_PROVIDER=hf
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx        # huggingface.co/settings/tokens (Read)

SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...                           # Project Settings -> API -> service_role
SUPABASE_BUCKET=tryon

# La genera el bootstrap (scripts/generate_default_model.py) y la sube al bucket
DEFAULT_PERSON_IMAGE_URL=https://<project>.supabase.co/storage/v1/object/public/tryon/models/default.jpg

CORS_ORIGINS=https://<tu-app>.vercel.app
REFINE_REQUIRED=false        # false: si el refinado gratuito falla, se entrega la imagen base
JOB_TTL_SECONDS=86400

# --- Modelos HF (opcional; defaults razonables) ---
# HF_TRYON_SPACE=yisol/IDM-VTON
# HF_REFINE_MODEL=black-forest-labs/FLUX.1-Kontext-dev
# HF_TEXT2IMG_MODEL=black-forest-labs/FLUX.1-schnell
# HF_LLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# HF_LLM_TEXT_MODEL=Qwen/Qwen3.5-9B

# === OPCIONALES DE PAGO ===
# ANTHROPIC_API_KEY=sk-ant-...        # si existe, la mejora de prompt usa Claude
# CLAUDE_MODEL=claude-sonnet-4-5
# AI_PROVIDER=replicate
# REPLICATE_API_TOKEN=r8_...
# S3_ENDPOINT_URL= / S3_ACCESS_KEY_ID= / S3_SECRET_ACCESS_KEY= / S3_PUBLIC_BASE_URL=   # R2/S3 en vez de Supabase Storage
